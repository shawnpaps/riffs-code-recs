---
import { fetchAllBlogPosts } from "../lib/functions";

const data = await fetchAllBlogPosts();
---

<ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
	{
		data?.map((post, index) => (
			<li
				class="group relative glass rounded-2xl overflow-hidden card-hover shimmer h-full"
				style={`animation-delay: ${index * 100}ms`}
			>
				<a
					href={post.web_url}
					target="_blank"
					rel="noopener noreferrer"
					class="block h-full"
				>
					{/* Image Container */}
					<div class="relative h-56 overflow-hidden">
						<img
							class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
							src={post.thumbnail_url}
							alt={post.title}
							loading="lazy"
						/>
						<div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent opacity-60 group-hover:opacity-40 transition-opacity duration-300" />

						{/* Floating Badge */}
						<div class="absolute top-4 right-4">
							<span class="glass-strong px-3 py-1 rounded-full text-xs font-medium text-white/90">
								Article
							</span>
						</div>
					</div>

					{/* Content */}
					<div class="relative p-6 space-y-3">
						<h3 class="text-xl font-bold text-white group-hover:gradient-text transition-all duration-300 line-clamp-2 leading-tight">
							{post.title}
						</h3>

						{/* Meta Info */}
						{post.subtitle && (
							<p class="text-sm text-white/60 line-clamp-2">
								{post.subtitle}
							</p>
						)}

						{/* Read More Link */}
						<div class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 pt-2">
							<span class="inline-flex items-center gap-2 text-sm text-pink-400 font-medium">
								Read Article
								<svg
									class="w-4 h-4 group-hover:translate-x-1 transition-transform"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M14 5l7 7m0 0l-7 7m7-7H3"
									/>
								</svg>
							</span>
						</div>
					</div>

					{/* Hover Gradient Overlay */}
					<div class="absolute inset-0 gradient-bg opacity-0 group-hover:opacity-10 transition-opacity duration-500 pointer-events-none" />
				</a>
			</li>
		))
	}
</ul>

{/* Empty State */}
{
	(!data || data.length === 0) && (
		<div class="text-center py-16 glass rounded-2xl">
			<svg
				class="w-16 h-16 mx-auto text-white/40 mb-4"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
				/>
			</svg>
			<p class="text-white/60 text-lg">No articles found</p>
			<p class="text-white/40 text-sm mt-2">
				Check back soon for new content!
			</p>
		</div>
	)
}
