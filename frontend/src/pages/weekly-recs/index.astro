---
import Layout from "../../layouts/Layout.astro";

// Fetch the parsed weekly recommendations
let weeklyData = null;
let error = null;

try {
	const baseURL = import.meta.env.PUBLIC_BASE_URL || 'http://localhost:4321';
	const response = await fetch(`${baseURL}/api/weekly-recs`);

	if (response.ok) {
		weeklyData = await response.json();
	} else {
		error = "Failed to load recommendations";
	}
} catch (e) {
	error = "Failed to fetch weekly recommendations";
	console.error(e);
}

const musicRecs = weeklyData?.aggregated?.music || [];
const techRecs = weeklyData?.aggregated?.tech || [];
const totalPosts = weeklyData?.total?.posts || 0;
---

<Layout
	title="Weekly Pull Request Archive"
	description="Explore all music and tech recommendations from our Weekly Pull Request newsletter series"
>
	<!-- Hero Section -->
	<section class="relative min-h-[70vh] flex items-center justify-center overflow-hidden">
		<div class="absolute inset-0 spotlight opacity-50"></div>

		<div class="container mx-auto px-6 relative z-10">
			<div class="max-w-5xl mx-auto text-center space-y-8">
				<div class="space-y-4 fade-in">
					<div class="inline-flex items-center gap-3 glass px-6 py-3 rounded-full mb-6">
						<svg class="w-5 h-5 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
						</svg>
						<span class="text-white/80 text-sm font-medium">Newsletter Archive</span>
					</div>

					<h1 class="text-6xl md:text-7xl lg:text-8xl font-bold tracking-tight">
						<span class="block gradient-text text-shadow-glow">Weekly Pull Request</span>
						<span class="block text-white/90 font-light">Archive</span>
					</h1>
				</div>

				<p class="text-xl md:text-2xl text-white/70 max-w-3xl mx-auto leading-relaxed slide-in-right delay-200">
					Every music track and tech tool recommended in our Weekly Pull Request newsletter series, automatically parsed and beautifully organized.
				</p>

				{weeklyData && (
					<div class="flex flex-wrap gap-6 justify-center pt-8 fade-in-scale delay-300">
						<div class="glass rounded-2xl px-8 py-4">
							<div class="text-3xl font-bold gradient-text">{totalPosts}</div>
							<div class="text-white/60 text-sm mt-1">Newsletter Issues</div>
						</div>
						<div class="glass rounded-2xl px-8 py-4">
							<div class="text-3xl font-bold gradient-text">{musicRecs.length}</div>
							<div class="text-white/60 text-sm mt-1">Music Recs</div>
						</div>
						<div class="glass rounded-2xl px-8 py-4">
							<div class="text-3xl font-bold gradient-text">{techRecs.length}</div>
							<div class="text-white/60 text-sm mt-1">Tech Recs</div>
						</div>
					</div>
				)}
			</div>
		</div>
	</section>

	{error ? (
		<!-- Error State -->
		<section class="container mx-auto px-6 py-24">
			<div class="max-w-2xl mx-auto text-center glass-strong rounded-3xl p-12">
				<svg class="w-16 h-16 mx-auto mb-4 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
				</svg>
				<h2 class="text-2xl font-bold text-white mb-2">Oops! Something went wrong</h2>
				<p class="text-white/60 mb-6">{error}</p>
				<a href="/" class="inline-flex items-center gap-2 px-6 py-3 gradient-bg rounded-full font-semibold hover:scale-105 transition-all">
					<span>Go Home</span>
				</a>
			</div>
		</section>
	) : (
		<>
			<!-- Music Recommendations Section -->
			{musicRecs.length > 0 && (
				<section class="container mx-auto px-6 py-24" data-animate>
					<div class="mb-12">
						<div class="flex items-center justify-between mb-4">
							<h2 class="text-5xl md:text-6xl font-bold">
								<span class="text-white/40 font-light">Music</span>
								<span class="gradient-text">Recommendations</span>
							</h2>
						</div>
						<div class="h-1 w-32 gradient-bg rounded-full"></div>
						<p class="text-white/60 mt-4">All music tracks recommended across our Weekly Pull Request newsletters</p>
					</div>

					<ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
						{musicRecs.map((rec, index) => (
							<li
								class="group relative glass rounded-2xl overflow-hidden card-hover shimmer"
								style={`animation-delay: ${index * 50}ms`}
							>
								<div class="p-6 space-y-4">
									<!-- Music Icon -->
									<div class="w-14 h-14 glass-strong rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
										<svg class="w-7 h-7 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path>
										</svg>
									</div>

									<!-- Track Info -->
									<div class="space-y-2">
										<h3 class="text-xl font-bold text-white group-hover:gradient-text transition-all duration-300 line-clamp-2">
											{rec.title}
										</h3>
										<p class="text-white/60 text-sm">{rec.artist}</p>
									</div>

									{/* Links */}
									<div class="flex gap-3 pt-2">
										{rec.spotifyUrl && (
											<a
												href={rec.spotifyUrl}
												target="_blank"
												rel="noopener noreferrer"
												class="flex-1 glass-strong px-4 py-2 rounded-lg text-center text-sm font-medium text-green-400 hover:bg-green-400/10 transition-colors"
											>
												Spotify
											</a>
										)}
										{rec.appleMusicUrl && (
											<a
												href={rec.appleMusicUrl}
												target="_blank"
												rel="noopener noreferrer"
												class="flex-1 glass-strong px-4 py-2 rounded-lg text-center text-sm font-medium text-pink-400 hover:bg-pink-400/10 transition-colors"
											>
												Apple Music
											</a>
										)}
										{!rec.spotifyUrl && !rec.appleMusicUrl && (
											<div class="flex-1 glass-strong px-4 py-2 rounded-lg text-center text-sm text-white/40">
												No links available
											</div>
										)}
									</div>

									{rec.description && (
										<p class="text-white/50 text-xs line-clamp-2 pt-2 border-t border-white/10">
											{rec.description}
										</p>
									)}
								</div>

								<div class="absolute inset-0 gradient-bg opacity-0 group-hover:opacity-10 transition-opacity duration-500 pointer-events-none"></div>
							</li>
						))}
					</ul>
				</section>
			)}

			<!-- Tech Recommendations Section -->
			{techRecs.length > 0 && (
				<section class="container mx-auto px-6 py-24" data-animate>
					<div class="mb-12">
						<div class="flex items-center justify-between mb-4">
							<h2 class="text-5xl md:text-6xl font-bold">
								<span class="text-white/40 font-light">Tech</span>
								<span class="gradient-text">Recommendations</span>
							</h2>
						</div>
						<div class="h-1 w-32 gradient-bg rounded-full"></div>
						<p class="text-white/60 mt-4">All tech tools, frameworks, and resources from our Weekly Pull Request newsletters</p>
					</div>

					<ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
						{techRecs.map((rec, index) => (
							<li
								class="group relative glass rounded-2xl overflow-hidden card-hover shimmer"
								style={`animation-delay: ${index * 50}ms`}
							>
								<div class="p-6 space-y-4">
									<!-- Tech Icon -->
									<div class="w-14 h-14 glass-strong rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
										<svg class="w-7 h-7 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
										</svg>
									</div>

									<!-- Tech Info -->
									<div class="space-y-2">
										<h3 class="text-xl font-bold text-white group-hover:gradient-text transition-all duration-300 line-clamp-2">
											{rec.name}
										</h3>
										{rec.description && (
											<p class="text-white/60 text-sm line-clamp-3">
												{rec.description}
											</p>
										)}
										{rec.category && (
											<span class="inline-block px-3 py-1 glass-strong rounded-full text-xs font-medium text-white/70">
												{rec.category}
											</span>
										)}
									</div>

									{rec.url && (
										<a
											href={rec.url}
											target="_blank"
											rel="noopener noreferrer"
											class="inline-flex items-center gap-2 text-sm font-medium text-cyan-400 hover:text-cyan-300 transition-colors pt-2"
										>
											<span>Visit Website</span>
											<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
											</svg>
										</a>
									)}
								</div>

								<div class="absolute inset-0 gradient-bg opacity-0 group-hover:opacity-10 transition-opacity duration-500 pointer-events-none"></div>
							</li>
						))}
					</ul>
				</section>
			)}

			<!-- Empty State -->
			{musicRecs.length === 0 && techRecs.length === 0 && (
				<section class="container mx-auto px-6 py-24">
					<div class="max-w-2xl mx-auto text-center glass-strong rounded-3xl p-12">
						<div class="w-24 h-24 mx-auto mb-6 glass rounded-full flex items-center justify-center">
							<svg class="w-12 h-12 text-white/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
							</svg>
						</div>
						<h2 class="text-2xl font-bold text-white mb-2">No Recommendations Yet</h2>
						<p class="text-white/60 mb-6">We're still parsing the Weekly Pull Request newsletters. Check back soon!</p>
					</div>
				</section>
			)}

			<!-- CTA Section -->
			<section class="container mx-auto px-6 py-24">
				<div class="max-w-4xl mx-auto">
					<div class="relative glass-strong rounded-3xl p-12 overflow-hidden neon-glow" data-animate>
						<div class="absolute inset-0 grid-background opacity-20"></div>

						<div class="relative z-10 text-center space-y-6">
							<div class="w-16 h-16 mx-auto gradient-bg rounded-2xl flex items-center justify-center mb-4">
								<svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
								</svg>
							</div>

							<h2 class="text-3xl md:text-4xl font-bold">
								<span class="gradient-text">Never Miss</span>
								<span class="text-white"> a Pull Request</span>
							</h2>

							<p class="text-lg text-white/70 max-w-2xl mx-auto">
								Subscribe to get the Weekly Pull Request delivered to your inbox every week with fresh music and tech recommendations.
							</p>

							<div class="pt-4">
								<a
									href="/join"
									class="inline-flex items-center gap-3 px-8 py-4 gradient-bg rounded-full text-lg font-bold text-white hover:scale-105 hover:shadow-2xl transition-all duration-300"
								>
									<span>Subscribe Now</span>
									<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
									</svg>
								</a>
							</div>

							<p class="text-sm text-white/40">Free forever. Unsubscribe anytime.</p>
						</div>
					</div>
				</div>
			</section>
		</>
	)}
</Layout>
