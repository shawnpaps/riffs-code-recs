---
import Layout from '../../layouts/Layout.astro';
import { fetchAllFromTable } from '../../lib/functions';

const data = await fetchAllFromTable('songs');

const sortedData = data?.sort((a, b) => {
	return new Date(b.sys.createdAt).getTime() - new Date(a.sys.createdAt).getTime();
});

// Group songs by artist for better organization
const groupedByArtist = sortedData?.reduce((acc, song) => {
	const artist = song.fields.artist;
	if (!acc[artist]) {
		acc[artist] = [];
	}
	acc[artist].push(song);
	return acc;
}, {} as Record<string, typeof sortedData>);

const totalSongs = sortedData?.length || 0;
const totalArtists = Object.keys(groupedByArtist || {}).length;
---

<Layout title="Music" description="Discover our curated playlist of music recommendations">
	<!-- Hero Section -->
	<section class="relative min-h-[60vh] flex items-center justify-center overflow-hidden">
		<!-- Animated Background -->
		<div class="absolute inset-0 spotlight opacity-40"></div>

		<div class="container mx-auto px-6 relative z-10">
			<div class="max-w-5xl mx-auto text-center space-y-8">
				<!-- Title -->
				<div class="space-y-4 fade-in">
					<div class="inline-flex items-center gap-3 glass px-6 py-3 rounded-full mb-6">
						<svg class="w-5 h-5 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path>
						</svg>
						<span class="text-white/80 text-sm font-medium">Music Recommendations</span>
					</div>

					<h1 class="text-6xl md:text-7xl lg:text-8xl font-bold tracking-tight">
						<span class="block text-white/90 font-light">The Official</span>
						<span class="block gradient-text text-shadow-glow">Riffs. Code. Coffee.</span>
						<span class="block text-white/90 font-light">Playlist</span>
					</h1>
				</div>

				<!-- Description -->
				<p class="text-xl md:text-2xl text-white/70 max-w-3xl mx-auto leading-relaxed slide-in-right delay-200">
					Every song that's made it into our newsletter, curated with love and attention to detail.
				</p>

				<!-- Stats -->
				<div class="flex flex-wrap gap-6 justify-center pt-8 fade-in-scale delay-300">
					<div class="glass rounded-2xl px-8 py-4">
						<div class="text-3xl font-bold gradient-text">{totalSongs}</div>
						<div class="text-white/60 text-sm mt-1">Total Tracks</div>
					</div>
					<div class="glass rounded-2xl px-8 py-4">
						<div class="text-3xl font-bold gradient-text">{totalArtists}</div>
						<div class="text-white/60 text-sm mt-1">Artists Featured</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Playlist Section -->
	<section class="container mx-auto px-6 py-16">
		<div class="max-w-5xl mx-auto">
			<!-- Playlist Header -->
			<div class="glass-strong rounded-3xl p-8 mb-8 neon-glow">
				<div class="flex items-center justify-between mb-4">
					<h2 class="text-3xl font-bold gradient-text">Full Playlist</h2>
					<div class="flex items-center gap-2 text-white/60 text-sm">
						<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
						<span>Updated weekly</span>
					</div>
				</div>
				<p class="text-white/70">
					Click any track to listen on Apple Music. Discover new sounds every week.
				</p>
			</div>

			<!-- Playlist Items -->
			<div class="space-y-3">
				{sortedData?.map((song, index) => (
					<div
						class="group glass rounded-2xl p-6 card-hover shimmer"
						style={`animation-delay: ${index * 30}ms`}
						data-animate
					>
						<a
							href={song.fields.appleMusicUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="flex items-center gap-6"
						>
							<!-- Track Number -->
							<div class="flex-shrink-0 w-12 h-12 glass-strong rounded-xl flex items-center justify-center group-hover:gradient-bg transition-all duration-300">
								<span class="font-bold text-white/80 group-hover:text-white transition-colors">
									{index + 1}
								</span>
							</div>

							<!-- Album Art Placeholder -->
							<div class="flex-shrink-0 w-16 h-16 glass-strong rounded-xl flex items-center justify-center overflow-hidden group-hover:scale-110 transition-transform duration-300">
								<svg class="w-8 h-8 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path>
								</svg>
							</div>

							<!-- Track Info -->
							<div class="flex-1 min-w-0">
								<h3 class="text-lg font-semibold text-white group-hover:gradient-text transition-all duration-300 truncate">
									{song.fields.title}
								</h3>
								<p class="text-white/60 text-sm truncate">
									{song.fields.artist}
								</p>
							</div>

							<!-- Play Button (Visible on Hover) -->
							<div class="flex-shrink-0 opacity-0 group-hover:opacity-100 transition-all duration-300">
								<div class="w-12 h-12 gradient-bg rounded-full flex items-center justify-center shadow-lg">
									<svg class="w-5 h-5 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24">
										<path d="M8 5v14l11-7z"></path>
									</svg>
								</div>
							</div>

							<!-- Apple Music Icon -->
							<div class="flex-shrink-0 group-hover:scale-110 transition-transform duration-300">
								<div class="w-10 h-10 bg-white/5 rounded-xl flex items-center justify-center">
									<svg class="w-5 h-5 text-white/60 group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
										<path d="M23.994 6.124c0-.738-.034-1.47-.098-2.198-.065-.728-.196-1.45-.393-2.167-.197-.717-.459-1.397-.785-2.04-.326-.643-.738-1.24-1.236-1.791-.498-.551-1.063-.995-1.694-1.332-.631-.337-1.314-.583-2.048-.738C16.006.034 15.274 0 14.536 0H9.464c-.738 0-1.47.034-2.198.099-.728.065-1.45.196-2.167.393-.717.197-1.397.459-2.04.785-.643.326-1.24.738-1.791 1.236-.551.498-.995 1.063-1.332 1.694-.337.631-.583 1.314-.738 2.048C.034 7.99 0 8.722 0 9.46v5.072c0 .738.034 1.47.099 2.198.065.728.196 1.45.393 2.167.197.717.459 1.397.785 2.04.326.643.738 1.24 1.236 1.791.498.551 1.063.995 1.694 1.332.631.337 1.314.583 2.048.738.734.155 1.466.221 2.204.221h5.072c.738 0 1.47-.034 2.198-.099.728-.065 1.45-.196 2.167-.393.717-.197 1.397-.459 2.04-.785.643-.326 1.24-.738 1.791-1.236.551-.498.995-1.063 1.332-1.694.337-.631.583-1.314.738-2.048.155-.734.221-1.466.221-2.204V6.124zM12 19.2c-3.974 0-7.2-3.226-7.2-7.2S8.026 4.8 12 4.8s7.2 3.226 7.2 7.2-3.226 7.2-7.2 7.2zm0-12c-2.651 0-4.8 2.149-4.8 4.8s2.149 4.8 4.8 4.8 4.8-2.149 4.8-4.8-2.149-4.8-4.8-4.8z"></path>
									</svg>
								</div>
							</div>

							<!-- Hover Gradient Overlay -->
							<div class="absolute inset-0 gradient-bg opacity-0 group-hover:opacity-5 transition-opacity duration-500 pointer-events-none rounded-2xl"></div>
						</a>
					</div>
				))}
			</div>

			<!-- Empty State -->
			{(!sortedData || sortedData.length === 0) && (
				<div class="text-center py-24 glass rounded-3xl">
					<div class="w-24 h-24 mx-auto mb-6 glass-strong rounded-full flex items-center justify-center">
						<svg class="w-12 h-12 text-white/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path>
						</svg>
					</div>
					<h3 class="text-2xl font-bold text-white/80 mb-2">No tracks yet</h3>
					<p class="text-white/60">Check back soon for new music recommendations!</p>
				</div>
			)}
		</div>
	</section>

	<!-- CTA Section -->
	<section class="container mx-auto px-6 py-24">
		<div class="max-w-4xl mx-auto">
			<div class="relative glass-strong rounded-3xl p-12 overflow-hidden neon-glow" data-animate>
				<div class="absolute inset-0 grid-background opacity-20"></div>

				<div class="relative z-10 text-center space-y-6">
					<div class="w-16 h-16 mx-auto gradient-bg rounded-2xl flex items-center justify-center mb-4">
						<svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
						</svg>
					</div>

					<h2 class="text-3xl md:text-4xl font-bold">
						<span class="gradient-text">Get New Tracks</span>
						<span class="text-white"> Weekly</span>
					</h2>

					<p class="text-lg text-white/70 max-w-2xl mx-auto">
						Subscribe to our newsletter and never miss a new addition to the playlist. Fresh music recommendations every week.
					</p>

					<div class="pt-4">
						<a
							href="/join"
							class="inline-flex items-center gap-3 px-8 py-4 gradient-bg rounded-full text-lg font-bold text-white hover:scale-105 hover:shadow-2xl transition-all duration-300"
						>
							<span>Subscribe Now</span>
							<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
							</svg>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>
