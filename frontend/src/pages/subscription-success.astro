---
import Layout from "../layouts/Layout.astro";

// Fetch subscriber count
let subscriberCount = "1000+";
try {
	const baseURL = import.meta.env.PUBLIC_BASE_URL || "http://localhost:4321";
	const response = await fetch(`${baseURL}/api/subscriber-count`);
	if (response.ok) {
		const data = await response.json();
		subscriberCount = data.formatted || "1000+";
	}
} catch (error) {
	console.error("Failed to fetch subscriber count:", error);
}
---

<Layout
	title="Welcome to the Community!"
	description="Thank you for subscribing to Riffs. Code. Coffee. newsletter"
>
	<!-- Success Section -->
	<section
		class="relative min-h-screen flex items-center justify-center overflow-hidden"
	>
		<!-- Animated Background -->
		<div class="absolute inset-0 spotlight opacity-50"></div>

		<div class="container mx-auto px-6 relative z-10">
			<div class="max-w-4xl mx-auto text-center">
				<!-- Success Animation -->
				<div class="mb-8 fade-in-scale">
					<div
						class="w-32 h-32 mx-auto mb-6 gradient-bg rounded-full flex items-center justify-center pulse-glow"
					>
						<svg
							class="w-16 h-16 text-white"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M5 13l4 4L19 7"></path>
						</svg>
					</div>
				</div>

				<!-- Main Message -->
				<div class="space-y-6 mb-12 fade-in delay-200">
					<h1
						class="text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight"
					>
						<span class="block gradient-text text-shadow-glow mb-4"
							>You're In! 🎉</span
						>
						<span
							class="block text-white/90 font-light text-3xl md:text-4xl"
							>Welcome to the Community</span
						>
					</h1>

					<p
						class="text-xl md:text-2xl text-white/70 max-w-2xl mx-auto leading-relaxed"
					>
						You've just joined <span
							class="gradient-text font-semibold"
							>{subscriberCount}</span
						> developers and music lovers who get the best tech and music
						recommendations every week.
					</p>
				</div>

				<!-- What's Next -->
				<div
					class="glass-strong rounded-3xl p-8 md:p-12 mb-12 fade-in delay-300"
				>
					<h2 class="text-2xl md:text-3xl font-bold text-white mb-8">
						What Happens Next?
					</h2>

					<div class="grid md:grid-cols-3 gap-6 text-left">
						<!-- Step 1 -->
						<div class="glass rounded-2xl p-6">
							<div
								class="w-12 h-12 gradient-bg rounded-xl flex items-center justify-center mb-4"
							>
								<span class="text-2xl font-bold text-white"
									>1</span
								>
							</div>
							<h3 class="text-lg font-bold text-white mb-2">
								Check Your Email
							</h3>
							<p class="text-white/60 text-sm leading-relaxed">
								We've sent you a confirmation email. Click the
								link to verify your subscription and ensure you
								never miss an issue.
							</p>
						</div>

						<!-- Step 2 -->
						<div class="glass rounded-2xl p-6">
							<div
								class="w-12 h-12 gradient-bg rounded-xl flex items-center justify-center mb-4"
							>
								<span class="text-2xl font-bold text-white"
									>2</span
								>
							</div>
							<h3 class="text-lg font-bold text-white mb-2">
								Explore the Site
							</h3>
							<p class="text-white/60 text-sm leading-relaxed">
								Browse our curated collection of music riffs and
								tech recommendations. There's plenty to discover
								while you wait!
							</p>
						</div>

						<!-- Step 3 -->
						<div class="glass rounded-2xl p-6">
							<div
								class="w-12 h-12 gradient-bg rounded-xl flex items-center justify-center mb-4"
							>
								<span class="text-2xl font-bold text-white"
									>3</span
								>
							</div>
							<h3 class="text-lg font-bold text-white mb-2">
								Get Weekly Updates
							</h3>
							<p class="text-white/60 text-sm leading-relaxed">
								Every week, you'll receive the Weekly Pull
								Request with hand-picked music and tech
								recommendations.
							</p>
						</div>
					</div>
				</div>

				<!-- Quick Actions -->
				<div
					class="flex flex-col sm:flex-row gap-4 justify-center items-center fade-in delay-500"
				>
					<a
						href="/music"
						class="group glass-strong px-8 py-4 rounded-full font-semibold text-white hover:scale-105 transition-all duration-300 flex items-center gap-2"
					>
						<svg
							class="w-5 h-5 text-purple-400"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"
							></path>
						</svg>
						<span>Browse Music</span>
					</a>

					<a
						href="/code"
						class="group glass-strong px-8 py-4 rounded-full font-semibold text-white hover:scale-105 transition-all duration-300 flex items-center gap-2"
					>
						<svg
							class="w-5 h-5 text-cyan-400"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"
							></path>
						</svg>
						<span>Explore Tech</span>
					</a>

					<a
						href="/weekly-recs"
						class="group glass-strong px-8 py-4 rounded-full font-semibold text-white hover:scale-105 transition-all duration-300 flex items-center gap-2"
					>
						<svg
							class="w-5 h-5 text-pink-400"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
							></path>
						</svg>
						<span>View Archive</span>
					</a>
				</div>

				<!-- Social Share -->
				<div
					class="mt-12 pt-12 border-t border-white/10 fade-in delay-700"
				>
					<p class="text-white/60 mb-4">
						Love what we do? Share with friends!
					</p>
					<div class="flex justify-center gap-4">
						<a
							href="https://twitter.com/intent/tweet?text=Just%20subscribed%20to%20@riffscodecoffee%20newsletter!%20Weekly%20tech%20and%20music%20recommendations.%20Check%20it%20out!"
							target="_blank"
							rel="noopener noreferrer"
							class="glass px-6 py-3 rounded-full text-sm font-medium text-white/80 hover:text-white hover:scale-105 transition-all duration-300"
						>
							Share on Twitter
						</a>
					</div>
				</div>
			</div>
		</div>

		<!-- Confetti Animation (Optional Enhancement) -->
		<div class="absolute inset-0 pointer-events-none overflow-hidden">
			<div class="confetti-piece" style="left: 10%; animation-delay: 0s;">
			</div>
			<div
				class="confetti-piece"
				style="left: 20%; animation-delay: 0.2s;"
			>
			</div>
			<div
				class="confetti-piece"
				style="left: 30%; animation-delay: 0.4s;"
			>
			</div>
			<div
				class="confetti-piece"
				style="left: 40%; animation-delay: 0.6s;"
			>
			</div>
			<div
				class="confetti-piece"
				style="left: 50%; animation-delay: 0.8s;"
			>
			</div>
			<div class="confetti-piece" style="left: 60%; animation-delay: 1s;">
			</div>
			<div
				class="confetti-piece"
				style="left: 70%; animation-delay: 1.2s;"
			>
			</div>
			<div
				class="confetti-piece"
				style="left: 80%; animation-delay: 1.4s;"
			>
			</div>
			<div
				class="confetti-piece"
				style="left: 90%; animation-delay: 1.6s;"
			>
			</div>
		</div>
	</section>
</Layout>

<style>
	@keyframes confetti-fall {
		0% {
			transform: translateY(-100vh) rotate(0deg);
			opacity: 1;
		}
		100% {
			transform: translateY(100vh) rotate(720deg);
			opacity: 0;
		}
	}

	.confetti-piece {
		position: absolute;
		top: -10%;
		width: 10px;
		height: 10px;
		background: linear-gradient(135deg, #8b5cf6, #ec4899, #06b6d4);
		animation: confetti-fall 3s ease-in-out infinite;
	}

	.confetti-piece:nth-child(odd) {
		background: linear-gradient(135deg, #ec4899, #8b5cf6);
	}

	.confetti-piece:nth-child(3n) {
		background: linear-gradient(135deg, #06b6d4, #ec4899);
	}
</style>
